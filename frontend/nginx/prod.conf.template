# Production (docker-compose.prod.yml). The nginx image fills in ${DOMAIN} and
# ${EXTRA_DOMAINS} from the environment at start (NGINX_ENVSUBST_TEMPLATE_DIR)
# and writes the result over conf.d/default.conf. Other $variables are nginx's own.
#
# DOMAIN         the site's only address: https://${DOMAIN}
# EXTRA_DOMAINS  other names (space-separated) that redirect to it with the path kept.
#                They must be in the certificate too: add them to .env and run deploy/cert.sh.

server_tokens off;

include /etc/nginx/snippets/log-format.conf;

# HSTS for security-headers.conf: the browser goes straight to HTTPS for this long.
# Started at one week (604800); how to raise it is in DEPLOY.md.
# No includeSubDomains: not every subdomain is guaranteed to be on HTTPS.
map $host $hsts {
    default "max-age=604800";
}

# One Let's Encrypt certificate for all names (deploy/cert.sh, --cert-name ${DOMAIN}).
ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
ssl_protocols TLSv1.2 TLSv1.3;
ssl_session_cache shared:SSL:10m;
ssl_session_timeout 1d;

# HTTP, any name: Let's Encrypt checks, everything else to HTTPS on the main domain.
server {
    listen 80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}

# HTTPS for names that are not ours (e.g. the bare IP): no certificate, no answer.
server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
}

# www and extra domains: redirect to the main domain with the path kept.
server {
    listen 443 ssl;
    http2 on;
    server_name www.${DOMAIN} ${EXTRA_DOMAINS};

    return 301 https://${DOMAIN}$request_uri;
}

# The site.
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    include /etc/nginx/snippets/app.conf;
}
