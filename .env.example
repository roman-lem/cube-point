# Copy to .env and set a random value, for example:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Session cookies over HTTPS only. Set 0 if you open the site over http
# from somewhere other than localhost (e.g. from a phone via the computer's LAN address).
# SECURE_COOKIES=0

# 0 closes registration ("registration opens soon"); login still works.
# REGISTRATION_OPEN=0
