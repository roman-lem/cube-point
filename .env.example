# Settings from environment variables. Copy to .env and fill in.
# Values without spaces, or in double quotes: deploy/*.sh read this file as a shell script.

# ---- Needed everywhere --------------------------------------------------------

# Random secret for signing sessions, at least 32 characters. Needed for local
# development too: without it (or with a short one) the backend refuses to start.
# `flask run` in backend/ reads this file (python-dotenv from requirements-dev.txt).
# Generate one:
#   python -c "import secrets; print(secrets.token_hex(32))"
# On the server without Python:  openssl rand -hex 32
# Changing it logs everyone out.
SECRET_KEY=

# ---- Production (docker-compose.prod.yml) -----------------------------------

# The site's address without https:// and www. The site opens only at
# https://DOMAIN; www.DOMAIN redirects there. Meetup links and QR codes use it.
DOMAIN=example.ru

# Other domains that redirect to DOMAIN with the path kept, space-separated,
# e.g. "example.com www.example.com". Their DNS must point to the server.
# After changing this, run: sh deploy/cert.sh
# EXTRA_DOMAINS=

# Email for Let's Encrypt: warnings if the certificate is about to expire
# (should not happen, renewal is automatic).
LETSENCRYPT_EMAIL=

# Days to keep daily database backups in the backend-data volume (deploy/backup.sh).
# Longer keeping is the provider's server snapshots' job.
# BACKUP_KEEP_DAYS=7

# gunicorn: processes and threads per process. 2 x 4 suits 1 CPU core and SQLite.
# WEB_CONCURRENCY=2
# GUNICORN_THREADS=4

# ---- Both ---------------------------------------------------------------------

# Mail: email confirmation and password recovery letters go through the mailbox
# on the site's domain, SMTP over SSL. Required in production (docker-compose.prod.yml
# does not start without MAIL_HOST). Without MAIL_HOST (local development) letters
# are not sent: only their subject goes to the backend log.
# MAIL_HOST=mail.hosting.reg.ru
# MAIL_PORT=465
# MAIL_USERNAME=noreply@cube-point.ru
# A password with $ or spaces goes in single quotes.
# MAIL_PASSWORD=
# Sender as shown in the mail app: name and address, in double quotes.
# MAIL_FROM="Имя отправителя <noreply@cube-point.ru>"

# Development only: without MAIL_HOST, write whole letters (with confirmation and
# password reset links) to the backend log. Production never passes it.
# MAIL_LOG_BODY=1

# Session cookies over HTTPS only (1 by default in local Docker). Set 0 if you open
# the local Docker site over http from somewhere other than localhost
# (e.g. from a phone via the computer's LAN address). Production ignores this:
# docker-compose.prod.yml always sets 1.
# SECURE_COOKIES=0

# 0 closes registration ("registration opens soon"); login still works.
# REGISTRATION_OPEN=0
