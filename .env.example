# Скопируйте в .env и задайте случайное значение, например:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Куки сессии только по HTTPS. 0 — если открываете сайт по http
# не с localhost (например, с телефона по адресу компьютера в локальной сети).
# SECURE_COOKIES=0

# 0 — регистрация закрыта («Регистрация скоро откроется»), вход работает.
# REGISTRATION_OPEN=0
